@{
    ViewData["Title"] = "Vásárlók:";
}
<h1>@ViewData["Title"]</h1>
<p>@Model.ToString()</p>
    <table class="table">
    <tbody>
    <thead>
        <th>Id</th>
        <th>Név</th>
        <th>Cím</th>
        <th>Telefon</th>
        <th>Email</th>
        <th>Pontszam</th>
    </thead>
@foreach (var item in Model)
{
            <tr>
            <td><a asp-area="" asp-controller="Home" asp-action="Vasarlo" asp-route-id="@item.Id">@item.Id</a></td>
            <td>@item.Nev</td>
            <td>@item.Cim</td>
            <td>@item.Telefon</td>
            <td>@item.Email</td>
            <td>@item.Pontszam</td>
            </tr>       
}
    </tbody>
    </table>



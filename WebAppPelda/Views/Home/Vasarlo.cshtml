@{
    ViewData["Title"] = "Vásárló adatai:";
}
<h1>@ViewData["Title"]</h1>


<table class="table">
    <thead>
    <th>Id</th>
    <th>Név</th>
    <th>Cím</th>
    <th>Telefon</th>
    <th>Email</th>
    <th>Pontszam</th>
    </thead>
    
    <tbody>
    <tr>
        <td>@Model.Id</td>
        <td>@Model.Nev</td>
        <td>@Model.Cim</td>
        <td>@Model.Telefon</td>
        <td>@Model.Email</td>
        <td>@Model.Pontszam</td>
    </tr>
    </tbody>
    </table>
